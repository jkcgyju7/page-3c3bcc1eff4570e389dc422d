28px;background:#fffaf0}\n.plan .body ul{list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:8px 18px}\n.plan .body li{font-size:.95rem;color:#3a1f23;padding-left:16px;position:relative}\n.plan .body li::before{content:\"—\";position:absolute;left:0;color:#8b2a3a}\n@media (max-width:680px){\n.plan{grid-template-columns:1fr}\n.plan .body ul{grid-template-columns:1fr}\n.plan.featured .name-block::after{top:auto;bottom:12px}\n}\n\n/* 使用步骤 */\n.steps{counter-reset:step;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px}\n.step{padding:22px;background:#efe6d4;border-left:6px solid #6a1b29;counter-increment:step}\n.step h3{font-size:1rem;letter-spacing:.1em;text-transform:uppercase;margin-bottom:6px}\n.step h3::before{content:counter(step,decimal-leading-zero) \" · \";color:#8b2a3a}\n.step p{font-size:.95rem}\n\n/* 客户端区 */\n.clients{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px}\n.client{padding:18px 20px 18px 26px;background:#fffaf0;border-left:6px solid #8b2a3a}\n.client h3{font-size:1.05rem;margin-bottom:4px}\n.client p{font-size:.92rem;color:#3a1f23}\n.client a{display:inline-block;margin-top:6px;font-size:.85rem;letter-spacing:.08em;border-bottom:1px dotted #6a1b29}\n\n/* FAQ 按主题分组 */\n.faq-group{margin-top:28px}\n.faq-group h3{font-size:1.1rem;color:#6a1b29;border-bottom:1px solid #8b2a3a;padding-bottom:4px;display:inline-block;margin-bottom:14px}\n.faq-item{background:#fffaf0;padding:16px 20px;border-left:4px solid #6a1b29;margin-bottom:10px}\n.faq-item summary{cursor:pointer;font-weight:600;color:#3a1f23;list-style:none}\n.faq-item summary::-webkit-details-marker{display:none}\n.faq-item summary::after{content:\" ＋\";color:#8b2a3a;font-weight:400}\n.faq-item[open] summary::after{content:\" －\";color:#8b2a3a}\n.faq-item p{margin-top:8px;font-size:.95rem;color:#3a1f23}\n\n/* 节点说明 */\n.node-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}\n.node{padding:14px 16px;background:#efe6d4;font-size:.92rem;color:#3a1f23}\n.node strong{color:#6a1b29;display:block;margin-bottom:2px;letter-spacing:.06em;font-size:.78rem;text-transform:uppercase}\n\n/* 底部固定文字导航 */\n.bottom-nav{position:fixed;left:0;right:0;bottom:0;background:#3a1f23;color:#f6f1e7;border-top:1px solid #6a1b29;z-index:10}\n.bottom-nav ul{list-style:none;display:flex;justify-content:space-around;align-items:center;padding:10px 6vw;flex-wrap:wrap;gap:6px}\n.bottom-nav a{color:#f6f1e7;font-size:.82rem;letter-spacing:.18em;text-transform:uppercase;border-bottom:1px solid transparent;padding:6px 4px;display:inline-block}\n.bottom-nav a:hover{color:#f6f1e7;background:transparent;border-bottom-color:#8b2a3a}\nbody{padding-bottom:64px}\n\nfooter{background:#3a1f23;color:#f6f1e7;padding:36px 6vw;margin-top:80px}\nfooter .inner{max-width:1120px;margin:0 auto;display:flex;flex-wrap:wrap;justify-content:space-between;gap:16px;font-size:.85rem}\nfooter a{color:#f6f1e7;border-bottom-color:rgba(246,241,231,.4)}\n</style><header class=\"hero\" id=\"top\">\n  <div class=\"hero-band b1\">\n    <div class=\"meta-row\">\n      <span><strong>第 12 期</strong></span>\n      <span><strong>通信笔记</strong></span>\n      <span><strong>TomLink · 编辑部</strong></span>\n    </div>\n    <h1>TomLink：在每一次连接里，写下你抵达世界的方式</h1>\n    <p class=\"standfirst\">这是一份写给需要稳定网络通道的远程工作者、流媒体常驻观众与小团队协作者的通信笔记。我们不卖承诺，只把连接的结构、流量节奏、资费与售后服务摊开在纸面上——读得懂，才用得久。</p>\n  </div>\n  <div class=\"hero-band b2\">\n    <p>从一台笔记本，一段被截断的会议连线，到一份必须在晚上九点前发出的设计稿——TomLink 把这些细节写进产品说明里。</p>\n  </div>\n  <div class=\"hero-band b3\">\n    全文约 2400 字 · 阅读约 9 分钟 · 资费公开 · 售后 7×24\n  </div>\n</header>\n\n<main class=\"container\">\n\n  <section id=\"editorial\">\n    <span class=\"eyebrow\">卷首语</span>\n    <h2>一封写给「连接焦虑」的回信</h2>\n    <p class=\"lead\">我们见过太多在凌晨三点的视频会议里掉线的人，也见过不少在跨年钟声响起时需要打开家中电视看一场海外直播的观众。TomLink 编辑部认为，连接这件事不该像抛硬币——它应该是可读的、可被规划、被复盘的。</p>\n    <p>本期，我们将编辑部内部讨论过的三类常见场景整理为一份通信笔记：远程办公的会议稳定、流媒体晚高峰的清晰度、以及小团队在多设备上的协同。无论你正处在其中的哪一段，下文都按场景列出了对应的线路偏好与建议节奏。</p>\n    <div class=\"epigraph\">\n      「我们试着把那些藏在用户协议里的名词，翻译成日常语言：什么是 IPLC 专线，什么是原生解锁，什么叫高带宽节点——然后让你自己决定要不要为它付费。」\n      —— TomLink 编辑部 · 主编手记\n    </div>\n  </section>\n\n  <section id=\"what\">\n    <span class=\"eyebrow\">关于产品</span>\n    <h2>TomLink 是什么：不卖承诺，只写说明</h2>\n    <p>TomLink 是一个面向个人与小型团队的连接服务说明文档式品牌。我们按月、按年提供可读的流量配额与设备并行数，并在每个套餐页面上公开价格、可用节点范围与售后响应时间。所有的功能描述都以「在什么场景下，能用以做什么事」开头，避免空泛的形容。</p>\n    <div class=\"cards\">\n      <div class=\"card\">\n        <h3>可读的资费</h3>\n        <p>每个套餐都列出月付价、年付价、流量上限与并行设备数，价格保持在 ¥15 / ¥35 / ¥85 三个档位，方便横向比较。</p>\n      </div>\n      <div class=\"card\">\n        <h3>三档套餐</h3>\n        <p>基础版适合个人轻度使用，旗舰版面向高频流媒体与游戏场景，团队版为 20 台设备规模的工作室或家庭设计。</p>\n      </div>\n      <div class=\"card\">\n        <h3>售后服务窗口</h3>\n        <p>工单回复承诺在工作日的 12 小时内，旗舰与团队版用户可走优先通道，详见各套餐说明。</p>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"scenes\">\n    <span class=\"eyebrow\">典型场景</span>\n    <h2>在哪些场景里，会读到 TomLink</h2>\n    <p>编辑部把过去一年用户来信中提到的几种典型状况整理出来。它们不构成对线路性能的承诺，只作为你选择套餐时的参考背景。</p>\n    <div class=\"cards\">\n      <div class=\"card\">\n        <h3>远程会议</h3>\n        <p>每日视频会议 2 至 4 小时，需要稳定的低延迟通道。推荐在旗舰版下启用 IPLC 专线节点，将会议工具置于优先队列。</p>\n      </div>\n      <div class=\"card\">\n        <h3>晚高峰流媒体</h3>\n        <p>晚间 8 点至 11 点观看海外剧集与体育直播，需要持续维持高清画质。基础版可应付标清需求，高清与 4K 建议选择旗舰或团队版。</p>\n      </div>\n      <div class=\"card\">\n        <h3>游戏与跨区服</h3>\n        <p>对操作延迟敏感，需搭配本地网络优化路由。建议把游戏流量与日常流量分开，使用支持原生解锁的节点。</p>\n      </div>\n      <div class=\"card\">\n        <h3>小团队协同</h3>\n        <p>5 至 20 人同时在线，需要统一管理账号与流量配比。团队版提供企业定制路由与专属客户经理，便于集中调度。</p>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"nodes\">\n    <span class=\"eyebrow\">节点与线路</span>\n    <h2>可读懂的节点名称：它们都代表什么</h2>\n    <p>TomLink 在客户端内按地区与用途标注节点。下表把常见的名词还原成日常语言，便于你按需选择。</p>\n    <div class=\"node-grid\">\n      <div class=\"node\"><strong>普通线路节点池</strong>适用于浏览网页、轻度办公；性价比最高，适合基础版用户。</div>\n      <div class=\"node\"><strong>IPLC 专线</strong>在国际段使用专线承载，会议与游戏场景延迟更稳定；包含于旗舰与团队版。</div>\n      <div class=\"node\"><strong>原生流媒体节点</strong>指能够匹配海外流媒体平台识别机制的出口；旗舰版全节点覆盖，团队版扩展至专属高带宽。</div>\n      <div class=\"node\"><strong>VIP 高带宽节点</strong>在晚高峰时段保持稳定吞吐，仅向团队版账号分配。</div>\n      <div class=\"node\"><strong>企业定制路由</strong>按客户行业（设计、研发、跨境电商）单独配置路线，团队版可选。</div>\n      <div class=\"node\"><strong>普通节点池</strong>面向基础版的公共入口，覆盖日常浏览与低占用应用。</div>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <span class=\"eyebrow\">资费与套餐</span>\n    <h2>三档套餐：按使用强度递增</h2>\n    <p>TomLink 把套餐从「设备并行数」与「每月流量」两个维度排成阶梯。下面的卡片从最轻量一直延伸到团队场景，价格、功能与年付优惠一并列出。</p>\n\n    <div class=\"plans\">\n      <article class=\"plan\">\n        <div class=\"name-block\">\n          <h3>基础版</h3>\n          <div class=\"price\">¥15 / 月</div>\n          <div class=\"annual\">按年付仅需 ¥150 / 年</div>\n        </div>\n        <div class=\"body\">\n          <ul>\n            <li>每月 100GB 极速流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </div>\n      </article>\n\n      <article class=\"plan featured\">\n        <div class=\"name-block\">\n          <h3>旗舰版</h3>\n          <div class=\"price\">¥35 / 月</div>\n          <div class=\"annual\">按年付仅需 ¥350 / 年</div>\n        </div>\n        <div class=\"body\">\n          <ul>\n            <li>每月 300GB 极速流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n        </div>\n      </article>\n\n      <article class=\"plan\">\n        <div class=\"name-block\">\n          <h3>团队版</h3>\n          <div class=\"price\">¥85 / 月</div>\n          <div class=\"annual\">按年付仅需 ¥850 / 年</div>\n        </div>\n        <div class=\"body\">\n          <ul>\n            <li>每月 1000GB 极速流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </div>\n      </article>\n    </div>\n\n    <p>价格以人民币标价，月付与年付可选。年付均价约等于月付 × 10，便于长期规划。所有套餐均不含任何附加手续费。</p>\n  </section>\n\n  <section id=\"howto\">\n    <span class=\"eyebrow\">使用流程</span>\n    <h2>从订阅到第一次连接，五个步骤</h2>\n    <p>TomLink 编辑部把注册到首次连接的过程拆成五步，每一步都可以独立完成。如果你只关心连接方式，可以直接跳到最后两步。</p>\n    <div class=\"steps\">\n      <div class=\"step\"><h3>选择套餐</h3><p>在资费页面对比三档套餐的流量、设备数与售后通道，按场景选定最贴近的一档。</p></div>\n      <div class=\"step\"><h3>填写订阅信息</h3><p>在订阅表单中填写邮箱与密码，确认支付方式后即可创建账号。</p></div>\n      <div class=\"step\"><h3>获取节点信息</h3><p>在订阅确认邮件中收到节点列表，每个节点都注明了用途与所在地区。</p></div>\n      <div class=\"step\"><h3>下载客户端</h3><p>在「客户端」区块选择与你系统对应的客户端，按说明完成安装。</p></div>\n      <div class=\"step\"><h3>导入并启动</h3><p>在客户端中粘贴订阅地址或扫码导入，挑选节点后点击连接按钮即可。</p></div>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <span class=\"eyebrow\">客户端</span>\n    <h2>多平台客户端说明</h2>\n    <p>TomLink 客户端支持主流桌面与移动系统。下列区块仅作系统兼容性说明，实际下载地址以你订阅后收到的邮件为准。</p>\n    <div class=\"clients\">\n      <div class=\"client\">\n        <h3>Windows / macOS</h3>\n        <p>支持 x64 架构，提供系统代理与全局模式切换；可在设置中导入订阅地址。</p>\n        <a href=\"#\">下载说明</a>\n      </div>\n      <div class=\"client\">\n        <h3>iOS / iPadOS</h3>\n        <p>可通过系统网络配置或第三方客户端接入；首次使用需在设置中信任描述文件。</p>\n        <a href=\"#\">配置指引</a>\n      </div>\n      <div class=\"client\">\n        <h3>Android</h3>\n        <p>提供 APK 包与通过邮件分发的安装包，建议保持后台运行以维持连接稳定。</p>\n        <a href=\"#\">下载说明</a>\n      </div>\n      <div class=\"client\">\n        <h3>路由器 / 软路由</h3>\n        <p>支持 OpenWrt 与主流第三方固件，可在后台面板批量添加节点并下发至局域网设备。</p>\n        <a href=\"#\">配置指引</a>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <span class=\"eyebrow\">常见问题</span>\n    <h2>读到这里，你大概会想到这些</h2>\n    <p>我们将过去三个月收到的来信整理为三个主题：套餐与计费、连接与技术、售后与变更。每条问答都尽可能把关键数字写明，避免空泛回答。</p>\n\n    <div class=\"faq-group\">\n      <h3>关于套餐与计费</h3>\n      <details class=\"faq-item\">\n        <summary>套餐之间可以随时升降级吗？</summary>\n        <p>可以。升档当日起按新套餐计费，剩余的旧套餐余额按比例抵扣；降档则在下个计费周期生效，期间流量与设备数维持原状。</p>\n      </details>\n      <details class=\"faq-item\">\n        <summary>流量用尽之后还能继续连接吗？</summary>\n        <p>当月流量用尽后，客户端仍可访问基础路由功能，但高带宽节点与流媒体解锁将暂停；次月 1 日恢复，建议提前在仪表盘查看剩余流量。</p>\n      </details>\n      <details class=\"faq-item\">\n        <summary>年付与月付的区别是什么？</summary>\n        <p>年付均价等同于月付 × 10，可在订阅管理页开启自动续费。若中途取消年付，未消耗的整月数按等比例退还。</p>\n      </details>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3>关于连接与技术</h3>\n      <details class=\"faq-item\">\n        <summary>在不同地区的晚高峰时段，连接体验会受影响吗？</summary>\n        <p>国际段带宽会受到公共互联网拥塞影响，因此旗舰与团队版默认优先调度专线节点；基础版用户可手动选择较近的普通节点。</p>\n      </details>\n      <details class=\"faq-item\">\n        <summary>为什么我换了一个节点之后访问速度差异很大？</summary>\n        <p>不同地区到目标服务之间的路由与运营商策略不同。建议在客户端中保存 2 至 3 个备选节点，按时段切换使用。</p>\n      </details>\n      <details class=\"faq-item\">\n        <summary>如何在客户端中导入订阅信息？</summary>\n        <p>登录后进入「订阅」页，将邮件中的地址粘贴到对应输入框，或扫描二维码。导入后需要重启客户端方可生效。</p>\n      </details>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3>关于售后与变更</h3>\n      <details class=\"faq-item\">\n        <summary>工单回复需要多久？</summary>\n        <p>基础版在工作日 12 小时内回复；旗舰版提供 7×24 优先工单；团队版由专属客户经理负责，平均响应在 4 小时以内。</p>\n      </details>\n      <details class=\"faq-item\">\n        <summary>如何更换账号绑定的邮箱？</summary>\n        <p>在「账号设置」中提交新邮箱，通过身份验证后即可完成迁移，原邮箱将收到一份通知。</p>\n      </details>\n      <details class=\"faq-item\">\n        <summary>是否提供发票或企业抬头？</summary>\n        <p>团队版订阅可申请开具发票，填写抬头后将通过电子邮件发送电子发票；月付与年付适用相同流程。</p>\n      </details>\n    </div>\n  </section>\n\n</main>\n\n<nav class=\"bottom-nav\" aria-label=\"页内导航\">\n  <ul>\n    <li><a href=\"#top\">开头</a></li>\n    <li><a href=\"#editorial\">卷首</a></li>\n    <li><a href=\"#what\">产品</a></li>\n    <li><a href=\"#plans\">资费</a></li>\n    <li><a href=\"#howto\">使用</a></li>\n    <li><a href=\"#clients\">客户端</a></li>\n    <li><a href=\"#faq\">问答</a></li>\n  </ul>\n</nav>\n\n<footer>\n  <div class=\"inner\">\n    <div>TomLink · 通信笔记编辑部</div>\n    <div>第 12 期 · 全文约 2400 字</div>\n    <div><a href=\"#top\">回到开头 ↑</a></div>\n  </div>\n</footer>",
