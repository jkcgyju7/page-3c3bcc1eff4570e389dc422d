          "body": "<style>\n*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}\nhtml,body{background:#f6f1e7;color:#3a1f23;line-height:1.75;font-family:Georgia,\"Songti SC\",\"Source Han Serif SC\",serif}\na{color:#6a1b29;text-decoration:none;border-bottom:1px solid rgba(106,27,41,.35)}\na:hover{background:#6a1b29;color:#f6f1e7;border-bottom-color:transparent}\nimg,svg{display:none}\n\n/* 全宽色带分层堆叠 hero */\n.hero{position:relative;width:100%;overflow:hidden;border-bottom:2px solid #3a1f23}\n.hero-band{width:100%;display:flex;align-items:flex-end;padding:32px 6vw}\n.hero-band.b1{background:#6a1b29;color:#f6f1e7;min-height:38vh;padding-top:64px;padding-bottom:48px}\n.hero-band.b2{background:#8b2a3a;color:#f6f1e7;min-height:18vh;padding-top:24px;padding-bottom:24px}\n.hero-band.b3{background:#3a1f23;color:#f6f1e7;min-height:10vh;padding-top:14px;padding-bottom:14px;font-size:.9rem;letter-spacing:.18em;text-transform:uppercase}\n.hero h1{font-size:clamp(2.6rem,7vw,5.8rem);line-height:1.05;letter-spacing:-.02em;font-weight:400;max-width:18ch}\n.hero .standfirst{margin-top:18px;max-width:42ch;font-size:clamp(1rem,1.6vw,1.2rem);color:#f6f1e7d9;border-left:2px solid #f6f1e7;padding-left:14px}\n.hero .meta-row{display:flex;flex-wrap:wrap;gap:22px;font-size:.85rem;letter-spacing:.14em;text-transform:uppercase;color:#f6f1e7cc}\n.hero .meta-row span strong{font-weight:400;color:#f6f1e7;border-bottom:1px dotted #f6f1e7}\n\n/* 主体 */\n.container{max-width:1120px;margin:0 auto;padding:48px 6vw 96px}\nsection{margin-top:64px}\n.eyebrow{font-size:.8rem;letter-spacing:.28em;text-transform:uppercase;color:#8b2a3a;border-bottom:1px solid rgba(138,42,58,.4);padding-bottom:4px;display:inline-block;margin-bottom:16px}\nh2{font-size:clamp(1.6rem,3vw,2.2rem);line-height:1.2;color:#3a1f23;font-weight:400;margin-bottom:14px}\nh3{font-size:1.15rem;color:#6a1b29;margin-bottom:8px;font-weight:600}\np{margin-bottom:14px;color:#3a1f23}\n.lead{font-size:1.15rem;max-width:62ch;color:#3a1f2